#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${EVEROS_MEMORY_BASE_URL:-http://127.0.0.1:8000}"
LABEL="${EVEROS_LAUNCH_AGENT_LABEL:-com.lengxiaochu.everos-memory}"
PLIST="${EVEROS_LAUNCH_AGENT_FILE:-$HOME/Library/LaunchAgents/$LABEL.plist}"
SERVICE="gui/$(id -u)/$LABEL"
ACTION="${1:-open}"

health_url="$BASE_URL/api/v1/dashboard/health"
dashboard_url="$BASE_URL/dashboard/"

require_launch_agent() {
  if [[ ! -f "$PLIST" ]]; then
    echo "error: launch agent not found: $PLIST" >&2
    echo "run setup first: bash scripts/setup_codex_everos_memory.sh" >&2
    exit 1
  fi
}

start_service() {
  require_launch_agent
  if ! launchctl print "$SERVICE" >/dev/null 2>&1; then
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
  fi
  launchctl enable "$SERVICE" >/dev/null 2>&1 || true
  launchctl kickstart -k "$SERVICE" >/dev/null
}

stop_service() {
  require_launch_agent
  launchctl bootout "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || true
}

wait_until_ready() {
  for _ in $(seq 1 40); do
    if curl --noproxy '*' -fsS "$health_url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  echo "error: EverOS API did not become ready: $health_url" >&2
  exit 2
}

case "$ACTION" in
  open|start)
    start_service
    wait_until_ready
    open "$dashboard_url"
    echo "Dashboard: $dashboard_url"
    ;;
  restart)
    stop_service
    start_service
    wait_until_ready
    open "$dashboard_url"
    echo "Dashboard: $dashboard_url"
    ;;
  stop)
    stop_service
    echo "Stopped: $LABEL"
    ;;
  status)
    if curl --noproxy '*' -fsS "$health_url" >/dev/null 2>&1; then
      echo "EverOS API: running"
      echo "Dashboard: $dashboard_url"
    else
      echo "EverOS API: unavailable"
      exit 1
    fi
    ;;
  logs)
    tail -n 80 "$HOME/.everos/server.out.log" "$HOME/.everos/server.err.log"
    ;;
  *)
    echo "usage: everos-dashboard [open|start|restart|stop|status|logs]" >&2
    exit 64
    ;;
esac
