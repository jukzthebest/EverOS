#!/usr/bin/env python3
"""Fast local EverOS memory helper for agent rules and hooks.

This script intentionally avoids importing ``everos`` for search/doctor paths.
It talks to the already-running local EverOS API, so Codex can recall memory
without paying Python package import + LanceDB setup costs on every query.
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass
from pathlib import Path
from typing import Any

DEFAULT_BASE_URL = os.environ.get("EVEROS_MEMORY_BASE_URL", "http://127.0.0.1:8000")
DEFAULT_USER_ID = os.environ.get("EVEROS_MEMORY_USER_ID", getpass.getuser() or "user")
DEFAULT_AGENT_ID = os.environ.get("EVEROS_MEMORY_AGENT_ID", "codex")
DEFAULT_APP_ID = os.environ.get("EVEROS_MEMORY_APP_ID", "codex")
DEFAULT_PROJECTS = tuple(
    project.strip()
    for project in os.environ.get("EVEROS_MEMORY_PROJECTS", "default").split(",")
    if project.strip()
) or ("default",)
PROJECT_ROOT = Path(__file__).resolve().parents[1]
DIRECT_LOOKUP_TERMS = tuple(
    term.strip()
    for term in os.environ.get(
        "EVEROS_MEMORY_DIRECT_LOOKUP_TERMS",
        "command,cmd,connect,login,shell,cli",
    ).split(",")
    if term.strip()
)


@dataclass(frozen=True)
class Hit:
    kind: str
    project_id: str
    score: float | None
    title: str
    body: str
    session_id: str | None
    item_id: str


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="everos-memory")
    parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Check the local EverOS API")
    doctor.set_defaults(func=cmd_doctor)

    search = subparsers.add_parser("search", help="Search local EverOS memory")
    search.add_argument("query")
    search.add_argument("--project", default="auto")
    search.add_argument("--limit", type=int, default=3)
    search.add_argument(
        "--method",
        default="keyword",
        choices=("keyword", "hybrid", "vector"),
    )
    search.add_argument("--owner", default="both", choices=("user", "agent", "both"))
    search.add_argument("--user-id", default=DEFAULT_USER_ID)
    search.add_argument("--agent-id", default=DEFAULT_AGENT_ID)
    search.add_argument("--app-id", default=DEFAULT_APP_ID)
    search.add_argument("--json", action="store_true", help="Emit raw normalized JSON")
    search.set_defaults(func=cmd_search)

    ingest = subparsers.add_parser(
        "import-codex",
        help="Import stable Codex sessions through the EverOS CLI",
    )
    ingest.add_argument("extra", nargs=argparse.REMAINDER)
    ingest.set_defaults(func=cmd_import_codex)

    args = parser.parse_args(argv)
    return int(args.func(args) or 0)


def cmd_doctor(args: argparse.Namespace) -> int:
    try:
        data = request_json(args.base_url, "/api/v1/dashboard/health", timeout=1.5)
    except RuntimeError as exc:
        print(f"EverOS API unavailable: {exc}", file=sys.stderr)
        return 2
    print(f"base_url: {args.base_url.rstrip('/')}")
    print(f"memory_root: {data.get('memory_root')}")
    print(f"markdown_files: {data.get('markdown_files')}")
    print(f"sqlite: {'present' if data.get('sqlite_exists') else 'missing'}")
    print(f"lancedb: {'present' if data.get('lancedb_exists') else 'missing'}")
    queue = data.get("queue") or {}
    print(
        "queue: "
        f"pending={queue.get('pending')} failed={queue.get('failed_retryable')} "
        f"lag={queue.get('lag')}"
    )
    print(f"embedding: {data.get('embedding_provider') or 'unknown'}")
    return 0


def cmd_search(args: argparse.Namespace) -> int:
    projects = resolve_projects(args.project)
    owners = ("user", "agent") if args.owner == "both" else (args.owner,)
    limit = max(1, min(args.limit, 50))
    recall_limit = max(limit * 4, 20)
    requests = [(project_id, owner) for project_id in projects for owner in owners]
    hits: list[Hit] = []
    with ThreadPoolExecutor(max_workers=min(8, len(requests) or 1)) as pool:
        futures = [
            pool.submit(
                search_scope,
                args.base_url,
                args.query,
                project_id,
                owner,
                args.user_id,
                args.agent_id,
                args.app_id,
                args.method,
                recall_limit,
            )
            for project_id, owner in requests
        ]
        for future in as_completed(futures):
            try:
                hits.extend(future.result())
            except RuntimeError as exc:
                print(f"warning: {exc}", file=sys.stderr)
    hits = filter_precise_identifier_hits(args.query, hits)
    hits = filter_direct_lookup_hits(args.query, hits)
    hits = filter_required_ascii_terms(args.query, hits)
    hits.sort(key=lambda hit: boosted_score(hit, args.query), reverse=True)
    hits = hits[:limit]
    if args.json:
        print(
            json.dumps(
                [hit_json(hit, args.query) for hit in hits],
                ensure_ascii=False,
                indent=2,
            )
        )
        return 0
    print_hits(args.query, hits)
    return 0 if hits else 1


def cmd_import_codex(args: argparse.Namespace) -> int:
    cmd = ["uv", "run", "everos", "import", "codex-structured", *args.extra]
    return subprocess.call(cmd, cwd=PROJECT_ROOT)


def resolve_projects(value: str) -> tuple[str, ...]:
    normalized = value.strip()
    lowered = normalized.lower()
    if lowered in {"", "auto", "all", "*"}:
        return DEFAULT_PROJECTS
    canonical = {project.lower(): project for project in DEFAULT_PROJECTS}
    return tuple(
        canonical.get(part.strip().lower(), part.strip())
        for part in normalized.split(",")
        if part.strip()
    )


def search_scope(
    base_url: str,
    query: str,
    project_id: str,
    owner: str,
    user_id: str,
    agent_id: str,
    app_id: str,
    method: str,
    limit: int,
) -> list[Hit]:
    payload: dict[str, Any] = {
        "app_id": app_id,
        "project_id": project_id,
        "query": query,
        "method": method,
        "top_k": limit,
    }
    if owner == "user":
        payload["user_id"] = user_id
    else:
        payload["agent_id"] = agent_id
    data = request_json(base_url, "/api/v1/memory/search", payload, timeout=4.0)
    if "error" in data:
        message = (data.get("error") or {}).get("message") or "unknown error"
        raise RuntimeError(f"{project_id}/{owner}: {message}")
    return normalize_hits(data.get("data") or {})


def request_json(
    base_url: str,
    path: str,
    payload: dict[str, Any] | None = None,
    *,
    timeout: float,
) -> dict[str, Any]:
    url = f"{base_url.rstrip('/')}{path}"
    body = None if payload is None else json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        headers={"content-type": "application/json"},
        method="GET" if payload is None else "POST",
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(request, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        try:
            detail = exc.read().decode("utf-8")
        except Exception:
            detail = str(exc)
        raise RuntimeError(detail) from exc
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(str(exc)) from exc


def normalize_hits(data: dict[str, Any]) -> list[Hit]:
    hits: list[Hit] = []
    for item in data.get("episodes") or []:
        hits.append(
            Hit(
                kind="episode",
                project_id=str(item.get("project_id") or ""),
                score=as_score(item.get("score")),
                title=str(item.get("subject") or item.get("summary") or item.get("id")),
                body=str(item.get("episode") or item.get("summary") or ""),
                session_id=maybe_str(item.get("session_id")),
                item_id=str(item.get("id") or ""),
            )
        )
    for item in data.get("agent_cases") or []:
        hits.append(
            Hit(
                kind="agent_case",
                project_id=str(item.get("project_id") or ""),
                score=as_score(item.get("score")),
                title=str(item.get("task_intent") or item.get("id")),
                body=join_text(item.get("key_insight"), item.get("approach")),
                session_id=maybe_str(item.get("session_id")),
                item_id=str(item.get("id") or ""),
            )
        )
    for item in data.get("agent_skills") or []:
        skill_name = str(item.get("name") or item.get("id") or "")
        description = str(item.get("description") or "")
        hits.append(
            Hit(
                kind="agent_skill",
                project_id=str(item.get("project_id") or ""),
                score=as_score(item.get("score")),
                title=description or skill_name,
                body=join_text(description, item.get("content")),
                session_id=None,
                item_id=str(item.get("id") or ""),
            )
        )
    return hits


def join_text(*values: Any) -> str:
    parts = []
    for value in values:
        text = str(value or "").strip()
        if text and text not in parts:
            parts.append(text)
    return "\n".join(parts)


def as_score(value: Any) -> float | None:
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def maybe_str(value: Any) -> str | None:
    return value if isinstance(value, str) and value else None


def print_hits(query: str, hits: list[Hit]) -> None:
    print(f"EverOS memory hits for: {query}")
    print("source=everos priority=primary")
    if not hits:
        print("No hits.")
        return
    for index, hit in enumerate(hits, 1):
        rank_score = boosted_score(hit, query)
        score = f" score={rank_score:.3f}"
        raw = "" if hit.score is None else f" raw={hit.score:.3f}"
        confidence = f" confidence={confidence_label(rank_score)}"
        print(
            f"{index}. [{hit.kind}][{hit.project_id}]{score}{raw}{confidence} "
            f"{clip(hit.title, 120)}"
        )
        if hit.body:
            print(f"   {clip(hit.body, 220)}")
        suffix = f"   id={hit.item_id}"
        if hit.session_id:
            suffix += f" session={hit.session_id}"
        print(suffix)


def confidence_label(score: float | None) -> str:
    if score is None:
        return "unknown"
    if score >= 8:
        return "high"
    if score >= 4:
        return "medium"
    return "low"


def hit_json(hit: Hit, query: str) -> dict[str, Any]:
    raw_score = hit.score
    rank_score = boosted_score(hit, query)
    return {
        **hit.__dict__,
        "score": rank_score,
        "raw_score": raw_score,
        "confidence": confidence_label(rank_score),
    }


def filter_direct_lookup_hits(query: str, hits: list[Hit]) -> list[Hit]:
    """Prefer hits that contain the named thing and a command block."""
    if not is_direct_lookup_query(query):
        return hits
    identifiers = explicit_identifiers(query)
    filtered = [
        hit for hit in hits
        if matches_lookup_identifier(hit, identifiers) and is_command_like_hit(hit)
    ]
    if filtered:
        lookup_terms = direct_lookup_intent_terms(query)
        if not lookup_terms:
            lookup_terms = non_identifier_query_terms(query, identifiers)
        preferred = [
            hit for hit in filtered
            if not lookup_terms or has_term_overlap(hit, lookup_terms)
        ]
        if preferred:
            return preferred
        return filtered
    if identifiers:
        identifier_hits = [
            hit for hit in hits if matches_lookup_identifier(hit, identifiers)
        ]
        if identifier_hits:
            return identifier_hits
    return filtered or hits


def is_direct_lookup_query(query: str) -> bool:
    lowered = query.lower()
    return bool(
        explicit_identifiers(query)
        and any(term.lower() in lowered for term in DIRECT_LOOKUP_TERMS)
    )


def explicit_identifiers(query: str) -> list[str]:
    return [
        match.group(0).lower()
        for match in re.finditer(r"[A-Za-z0-9_./:-]{3,}", query)
    ]


def matches_lookup_identifier(hit: Hit, identifiers: list[str]) -> bool:
    if not identifiers:
        return True
    text = searchable_text(hit)
    return any(identifier in text for identifier in identifiers)


def is_command_like_hit(hit: Hit) -> bool:
    text = f"{hit.title}\n{hit.body}".lower()
    return bool(
        re.search(r"```(?:bash|sh|shell|zsh|sql|console)?\s*\n", text)
        or re.search(
            r"(?m)^\s*(?:\$ ?)?(?:mysql|psql|ssh|scp|curl|kubectl|docker|"
            r"git|svn|uv|python3?|node|npm|pnpm|yarn|go|make|rg|grep|sed|awk)\b",
            text,
        )
        or re.search(
            r"\b(select|insert|update|delete|optimize\s+table|alter\s+table|create\s+table)\b",
            text,
        )
    )


def is_direct_lookup_hit(hit: Hit, identifiers: list[str]) -> bool:
    return matches_lookup_identifier(hit, identifiers) and is_command_like_hit(hit)


def non_identifier_query_terms(query: str, identifiers: list[str]) -> list[str]:
    identifier_set = set(identifiers)
    stopwords = {
        "the",
        "how",
        "what",
        "please",
    }
    return [
        token
        for token in query_tokens(query)
        if token not in identifier_set and token not in stopwords
    ]


def direct_lookup_intent_terms(query: str) -> list[str]:
    lowered = query.lower()
    return [term for term in DIRECT_LOOKUP_TERMS if term.lower() in lowered]


def has_term_overlap(hit: Hit, terms: list[str]) -> bool:
    text = searchable_text(hit)
    return any(term in text for term in terms)


def filter_precise_identifier_hits(query: str, hits: list[Hit]) -> list[Hit]:
    identifiers = [
        value
        for value in explicit_identifiers(query)
        if "_" in value
        or "." in value
        or re.search(r"\d", value)
        or value.endswith((".json", ".yaml", ".yml", ".sql"))
    ]
    if not identifiers:
        return hits
    filtered = []
    for hit in hits:
        text = f"{hit.title}\n{hit.body}".lower()
        if all(identifier in text for identifier in identifiers):
            filtered.append(hit)
    return filtered or hits


def filter_required_ascii_terms(query: str, hits: list[Hit]) -> list[Hit]:
    terms = required_ascii_terms(query)
    if not terms:
        return hits
    return [
        hit
        for hit in hits
        if all(term in searchable_text(hit) for term in terms)
    ]


def required_ascii_terms(query: str) -> list[str]:
    stopwords = {
        "and",
        "for",
        "from",
        "how",
        "into",
        "please",
        "that",
        "the",
        "this",
        "what",
        "when",
        "where",
        "why",
        "with",
    }
    terms = []
    for match in re.finditer(r"[A-Za-z][A-Za-z0-9_./:-]{2,}", query):
        term = match.group(0).lower()
        if term not in stopwords:
            terms.append(term)
    return list(dict.fromkeys(terms))


def searchable_text(hit: Hit) -> str:
    return f"{hit.title}\n{hit.body}\n{hit.item_id}".lower()


def boosted_score(hit: Hit, query: str) -> float:
    base = hit.score if hit.score is not None else 0.0
    tokens = query_tokens(query)
    if not tokens:
        return base
    title = hit.title.lower()
    body = hit.body.lower()
    boost = 0.0
    for token in tokens:
        if token in title:
            boost += 5.0
        if token in body:
            boost += 0.5
    if is_direct_lookup_query(query) and is_command_like_hit(hit):
        boost += 2.0
    return base + boost


def query_tokens(query: str) -> list[str]:
    tokens: list[str] = []
    for match in re.finditer(r"[A-Za-z0-9_./:-]{2,}|[\u4e00-\u9fff]+", query):
        token = match.group(0).lower()
        if re.fullmatch(r"[\u4e00-\u9fff]+", token):
            if len(token) <= 4:
                tokens.append(token)
            if len(token) > 2:
                tokens.extend(
                    token[index : index + 2] for index in range(len(token) - 1)
                )
            continue
        tokens.append(token)
    return list(dict.fromkeys(tokens))


def clip(text: str, limit: int) -> str:
    compact = " ".join(text.split())
    if len(compact) <= limit:
        return compact
    return compact[: limit - 1].rstrip() + "…"


if __name__ == "__main__":
    raise SystemExit(main())
